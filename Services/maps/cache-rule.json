{
  "ref": "ridge_maps_static_assets",
  "description": "Ridge maps: versioned downloads",
  "expression": "(http.host eq \"maps.bilellaworks.com\" and (starts_with(http.request.uri.path, \"/pilot-\") or starts_with(http.request.uri.path, \"/releases/\")))",
  "action": "set_cache_settings",
  "action_parameters": {
    "cache": true,
    "edge_ttl": { "mode": "bypass_by_default" },
    "browser_ttl": { "mode": "respect_origin" },
    "respect_strong_etags": true
  },
  "enabled": true
}
